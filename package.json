{
  "name": "guide-antidotes-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Démo – Guide canadien des antidotes (FR/EN), application web installable hors ligne",
  "type": "module",
  "scripts": {
    "download": "python3 scripts/download.py",
    "extract": "python3 scripts/extract.py",
    "verify": "python3 scripts/verify.py",
    "report": "python3 scripts/report.py",
    "check": "node build/check.mjs",
    "build": "node build/check.mjs && node build/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "serve": "node build/serve.mjs",
    "test:offline": "node tests/offline.e2e.mjs"
  },
  "dependencies": {
    "markdown-it": "14.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
